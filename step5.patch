+function mergeResources(
+  baseResourceList: Resource[],
+  importedResourceList: ImportedResource[],
+) {
+  const seenIds = new Set(baseResourceList.map((resource) => resource.id));
+  const seenSourceUrls = new Set(
+    baseResourceList.map((resource) => resource.sourceUrl).filter(Boolean),
+  );
+  const seenTitles = new Set(
+    baseResourceList.map((resource) => resource.titleEn.toLowerCase()).filter(Boolean),
+  );
+  const uniqueImportedResources = importedResourceList.filter((resource) => {
+    const titleKey = resource.titleEn.toLowerCase();
+
+    return (
+      !seenIds.has(resource.id) &&
+      !seenSourceUrls.has(resource.sourceUrl) &&
+      !seenTitles.has(titleKey)
+    );
+  });
+
+  return [...baseResourceList, ...uniqueImportedResources];
+}
+
+const normalizedAcceptedResources = (acceptedResources as AcceptedResourceInput[]).map(
+  normalizeAcceptedResource,
+);
+
+export const resources: Resource[] = mergeResources(
